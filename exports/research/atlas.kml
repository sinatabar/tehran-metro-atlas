بان آغاز کار نخستین ایستگاه کنار بیمارستان حکیم را گزارش کرد. در ۳ آذر مدیرعامل شرکت مترو از تجهیز کارگاه و انتظار برای ابلاغ نهایی قرارداد خبر داد.","en":"A contractor is identified. The project lead reported initial works beside Hakim Children’s Hospital on 27 October. On 24 November the metro company described mobilization with formal contract notification pending."}</value></Data><Data name="number"><value>11</value></Data><Data name="color"><value>null</value></Data><Data name="constructionStatus"><value>contract_awarded</value></Data><Data name="dataset"><value>research</value></Data><Data name="uncertaintyM"><value>null</value></Data><Data name="effectiveFrom"><value>null</value></Data><Data name="effectiveTo"><value>null</value></Data><Data name="entity"><value>lines</value></Data><Data name="version"><value>2026.11.24.1</value></Data><Data name="attribution"><value>Independent factual inventory · see DATA_LICENSE.md and linked sources for reuse terms</value></Data><Data name="sourceUrls"><value>["https://www.guenoengineers.com/contractor/blog/1582635005","https://www.shahrhayejahan.ir/FileUpload/Files/Files/File/6363750187980000.pdf","https://www.tasnimnews.ir/fa/news/1405/02/05/3574481/%D8%B2%D8%A7%DA%A9%D8%A7%D9%86%DB%8C-%D8%A2%D8%AE%D8%B1%DB%8C%D9%86-%D9%88%D8%B6%D8%B9%DB%8C%D8%AA-%D8%AA%D9%88%D8%B3%D8%B9%D9%87-%D8%AE%D8%B7%D9%88%D8%B7-8-9-%D9%88-11-%D9%85%D8%AA%D8%B1%D9%88-%D8%B1%D8%A7-%D8%A7%D8%B9%D9%84%D8%A7%D9%85-%DA%A9%D8%B1%D8%AF","https://mehrnews.com/x3drZv","https://www.tasnimnews.ir/fa/news/1405/09/03/3756832/%D8%AE%D8%B7-9-%D9%85%D8%AA%D8%B1%D9%88-%D8%B3%D9%87-%DA%86%D9%87%D8%A7%D8%B1%D9%85-%D8%B1%DB%8C%D9%86%DA%AF-%D9%BE%DB%8C%D8%B1%D8%A7%D9%85%D9%88%D9%86%DB%8C-%D8%AA%D9%87%D8%B1%D8%A7%D9%86-%D8%B1%D8%A7-%D8%AA%DA%A9%D9%85%DB%8C%D9%84-%D9%85%DB%8C-%DA%A9%D9%86%D8%AF","https://tasnimnews.ir/fa/news/1402/11/13/3031914/%D8%B4%D9%87%D8%B1%D8%AF%D8%A7%D8%B1%DB%8C-%D8%AA%D9%87%D8%B1%D8%A7%D9%86-%DB%8C%DA%A9-%DA%AF%D8%A7%D9%85-%D8%A8%D9%87-%D8%B1%D