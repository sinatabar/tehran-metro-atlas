  "placeEvidence": [
    {
      "placeId": "place-vanak-square",
      "sourceIds": [
        "line9-earlier",
        "line9-start",
        "sabir-line9"
      ],
      "notes": {
        "fa": "در شرح مسیر سال ۱۴۰۳ خط نه از میدان ونک نام برده شد. گزارش آغاز عملیات در آذر ۱۴۰۵ جانمایی ایستگاهی در میدان را مشخص نکرد.",
        "en": "A 2024 description of Line 9 names Vanak Square on the corridor. The November 2026 launch report does not locate a station in the square."
      }
    },
    {
      "placeId": "place-vanak",
      "sourceIds": [
        "line9-earlier",
        "line9-start",
        "sabir-line9"
      ],
      "notes": {
        "fa": "گزارش سال ۱۴۰۳ به میدان ونک در مسیر خط نه اشاره دارد. برای ارزیابی دسترسی، میدان و محله ونک را جداگانه جست‌وجو کنید.",
        "en": "A 2024 description of Line 9 names Vanak Square. Search the square and the neighborhood separately when examining access."
      }
    },
    {
      "placeId": "place-rafsanjani",
      "sourceIds": [
        "master-plan-brief",
        "line10-west"
      ],
      "notes": {
        "fa": "بزرگراه هاشمی رفسنجانی در توصیف تاریخی کریدور خط ده آمده است. جانمایی دقیق ایستگاهی بر بزرگراه در اسناد بررسی‌شده احراز نشد.",
        "en": "A historical Line 10 corridor description names Hashemi Rafsanjani Highway. The reviewed sources do not establish a precise station location on it."
      }
    },
    {
      "placeId": "place-parkway",
      "sourceIds": [
        "line10-expanded",
        "line10-west"
      ],
      "notes": {
        "fa": "پارک‌وی در فهرست برنامه‌ریزی خط ده به نقل از مدیر طرح آمده است. نام‌گذاری نهایی، محل سکو و تاریخ افتتاح مشخص نیست.",
        "en": "A planning account attributed to the Line 10 director names Parkway. A final passenger name, platform location and opening date remain unverified."
      }
    },
    {
      "placeId": "place-mellat-park",
      "sourceIds": [
        "line10-expanded",
        "line9-earlier",
        "sabir-line9"
      ],
      "notes": {
        "fa": "در گزارش‌های بررسی‌شده ایستگاهی با جانمایی مستند در بوستان ملت پیدا نشد. میدان ملتِ ذکرشده در مسیر خط نه مکان دیگری است.",
        "en": "The reviewed reports do not identify a station in Mellat Park. Meydan-e Mellat in the Line 9 corridor description is a different place."
      }
    },
    {
      "placeId": "place-jordan",
      "sourceIds": [
        "line10-expanded",
        "line9-earlier"
      ],
      "notes": {
        "fa": "در منابع بررسی‌شده محل دقیق ایستگاه آینده برای محله جردن احراز نشده است. نام بوستان یا محله به‌تنهایی مبنای جانمایی ایستگاه نیست.",
        "en": "The reviewed sources do not establish a future station location for Jordan. Nearby named corridors alone do not establish station access."
      }
    },
    {
      "placeId": "place-mandela",
      "sourceIds": [
        "line10-expanded",
        "line9-earlier"
      ],
      "notes": {
        "fa": "در منابع بررسی‌شده محل دقیق ایستگاه آینده برای بلوار نلسون ماندلا احراز نشده است. نام بوستان یا محله به‌تنهایی مبنای جانمایی ایستگاه نیست.",
        "en": "The reviewed sources do not establish a future station location for Nelson Mandela Boulevard. Nearby named corridors alone do not establish station access."
      }
